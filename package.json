{
  "name": "tanstack_start_ts",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "node scripts/vite-with-tailwind-compat.mjs dev",
    "build": "node scripts/vite-with-tailwind-compat.mjs build",
    "build:dev": "node scripts/vite-with-tailwind-compat.mjs build --mode development",
    "check": "npm run typecheck && npm run build && npm test && npm run lint && npm run doctor && npm audit --audit-level=moderate",
    "typecheck": "tsc --noEmit",
    "doctor": "react-doctor --scope full --blocking warning .",
    "smoke:a11y": "node scripts/smoke-a11y.mjs --start-server",
    "smoke:a11y:quick": "node scripts/smoke-a11y.mjs --start-server --quick",
    "smoke:a11y:auth": "node scripts/smoke-a11y-auth.mjs",
    "publish:prepare": "node scripts/publish-prepare.mjs",
    "publish:finish": "node scripts/publish-finish.mjs",
    "changelog:check": "node scripts/changelog-quality-check.mjs",
    "release": "node scripts/release.mjs",
    "release:dry-run": "node scripts/release.mjs --dry-run",
    "setup": "npx --yes npm@12.0.2 ci",
    "brand:assets": "node scripts/generate-logo-assets.mjs",
    "db:advisors:security": "npx supabase db advisors --linked --type security",
    "db:advisors:performance": "npx supabase db advisors --linked --type performance",
    "db:push:dry-run": "npx supabase db push --linked --dry-run",
    "db:verify": "node scripts/db-verify.mjs",
    "db:types": "npx supabase gen types typescript --linked --schema public > src/integrations/supabase/types.ts",
    "prepush:guard": "node scripts/prepush-guard.mjs",
    "preview": "node scripts/vite-with-tailwind-compat.mjs preview",
    "lint": "oxlint",
    "test": "vitest run --config vitest.config.ts && node --test scripts/*.test.mjs",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:coverage:global": "vitest run --coverage --config vitest.coverage-global.config.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "format:changed": "node scripts/format-changed.mjs --write",
    "format:changed:check": "node scripts/format-changed.mjs --check"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.31",
    "@tanstack/react-start": "^1.168.48",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "nitro": "^3.0.260610-beta",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "playwright": "^1.62.1",
    "react-doctor": "0.9.12",
    "supabase": "^2.115.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "encoding-sniffer": "^1.0.2"
  },
