{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "npm@11.14.1",
  "engines": {
    "node": "24.x",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "node scripts/vite-with-tailwind-compat.mjs dev",
    "build": "node scripts/vite-with-tailwind-compat.mjs build",
    "build:dev": "node scripts/vite-with-tailwind-compat.mjs build --mode development",
    "ci:local": "npm run build && npm test && npm run lint && npm audit --audit-level=moderate",
    "quality:react-doctor": "npx --yes react-doctor@latest --scope full --blocking error .",
    "smoke:a11y": "node scripts/smoke-a11y.mjs --start-server",
    "smoke:a11y:quick": "node scripts/smoke-a11y.mjs --start-server --quick",
    "smoke:a11y:auth": "node scripts/smoke-a11y-auth.mjs",
    "codex:comments": "GITHUB_REPOSITORY=max23468/Pratix node .github/scripts/handle-codex-pr-comments.mjs",
    "codex:comments:dry-run": "DRY_RUN=true GITHUB_REPOSITORY=max23468/Pratix node .github/scripts/handle-codex-pr-comments.mjs",
    "publish:prepare": "node scripts/publish-prepare.mjs",
    "publish:finish": "node scripts/publish-finish.mjs",
    "changelog:check": "node scripts/changelog-quality-check.mjs",
    "release": "node scripts/release.mjs",
    "release:dry-run": "node scripts/release.mjs --dry-run",
    "brand:assets": "node scripts/generate-logo-assets.mjs",
    "db:advisors:security": "npx supabase db advisors --linked --type security",
    "db:advisors:performance": "npx supabase db advisors --linked --type performance",
    "db:push:dry-run": "npx supabase db push --linked --dry-run",
    "db:verify": "node scripts/db-verify.mjs",
    "db:types": "npx supabase gen types typescript --linked --schema public > src/integrations/supabase/types.ts",
    "prepush:guard": "node scripts/prepush-guard.mjs",
    "preview": "node scripts/vite-with-tailwind-compat.mjs preview",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:coverage:global": "vitest run --coverage --config vitest.coverage-global.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:changed": "node scripts/format-changed.mjs --write",
    "format:changed:check": "node scripts/format-changed.mjs --check"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "^1.168.26",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fflate": "^0.8.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.3.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "axe-core": "^4.12.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "nitro": "^3.0.260610-beta",
    "playwright": "^1.61.1",
    "prettier": "^3.9.1",
    "supabase": "^2.108.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "encoding-sniffer": "^1.0.2"
  }
}
